# Optional Service Role Secret (has bypass RLS permissions for server-side operations)
SUPABASE_SERVICE_ROLE_KEY=""

# Vite client-side exposure (optional if needed directly in frontend)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ==============================================================================
# SerpApi Google Maps Engine Configuration
# Obtain your API key from: https://serpapi.com/manage-api-key
# ==============================================================================
SERPAPI_KEY=""
VITE_SERPAPI_KEY=""
